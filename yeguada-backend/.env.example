# Copia este archivo a .env (NO se versiona) y ajusta los valores.
# Todo lo sensible (claves, contraseñas, correos de cuentas) va SOLO en .env, nunca en el código.
# El backend carga este archivo solo (yeguada-backend/.env, Node 20.12+). Las variables que ya
# existan en el entorno (hosting, `export`) tienen prioridad.

# Puerto del backend (si lo cambias, ajusta también "proxy" en yeguada-frontend/package.json)
# PORT=3001

# URL pública del dashboard — se usa en los enlaces de los correos y en CORS
APP_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000

# Administrador inicial (opcional). Si la base de datos no tiene usuarios, se crea
# esta cuenta al arrancar y se omite la pantalla de "crear administrador".
# Solo actúa con la tabla de usuarios vacía; después puedes quitar estas líneas.
# La contraseña debe tener 10+ caracteres, con letras y números.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# En producción (NODE_ENV=production) la pantalla "crear administrador" está CERRADA.
# Si no hay usuarios y no defines ADMIN_EMAIL/ADMIN_PASSWORD, el servidor no arranca.
# Solo para un primer despliegue manual y por pocos minutos: ALLOW_SETUP=true
# ALLOW_SETUP=false

# Correo con Resend (https://resend.com). Sin RESEND_API_KEY los correos se imprimen en la consola del backend.
# 1) Crea una API key en Resend  2) Verifica tu dominio (Domains)  3) usa un remitente de ese dominio.
# Sin dominio verificado solo puedes usar onboarding@resend.dev y únicamente llega al correo dueño de la cuenta.
RESEND_API_KEY=
MAIL_FROM="Ecoturismo La Yeguada OBC <no-reply@tudominio.com>"
# MAIL_REPLY_TO=contacto@tudominio.com

# Sesión y recuperación
SESSION_TTL_DAYS=7
RESET_TTL_MINUTES=30

# Producción
# NODE_ENV=production      # cookies Secure (requiere HTTPS)
# TRUST_PROXY=1            # si va detrás de nginx / un balanceador

# Usuarios de desarrollo para `npm run seed` (solo local; no corre en producción).
# Si dejas la contraseña vacía, el seed genera una aleatoria y la muestra una vez.
SEED_ADMIN_EMAIL=demo@yeguada.local
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_EMAIL=operador@yeguada.local
SEED_OPERATOR_PASSWORD=
